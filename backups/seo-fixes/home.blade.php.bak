@push('scripts')
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('bm-search-input');
            const matchContainer = document.querySelector('.bm-match-list');

            if (!matchContainer) return;

            // Search Logic
            if (searchInput) {
                searchInput.addEventListener('input', function (e) {
                    const term = e.target.value.toLowerCase();
                    const cards = matchContainer.querySelectorAll('.bm-match-row-premium');

                    cards.forEach(card => {
                        const teamsElem = card.querySelectorAll('.bm-team-name-text');
                        const teamTexts = Array.from(teamsElem).map(el => el.textContent.toLowerCase()).join(' ');
                        const leagueData = card.closest('.bm-match-group')?.getAttribute('data-league')?.toLowerCase() || '';

                        if (teamTexts.includes(term) || leagueData.includes(term)) {
                            card.style.display = '';
                        } else {
                            card.style.display = 'none';
                        }
                    });

                    document.querySelectorAll('.bm-match-group').forEach(group => {
                        const visibleCards = Array.from(group.querySelectorAll('.bm-match-row-premium')).filter(c => c.style.display !== 'none');
                        const header = group.querySelector('.bm-league-header');
                        if (header) {
                            header.style.display = visibleCards.length > 0 ? '' : 'none';
                        }
                    });
                });
            }
        });
    </script>
@endpush